{
  "openapi": "3.1.0",
  "info": {
    "title": "Revised Cardiac Risk Index API",
    "description": "Six-factor RCRI scoring and separate legacy demonstration endpoints.",
    "version": "3.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Run legacy generic demonstration worker evaluation (not RCRI scoring)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return offline demonstration chat response (not clinical verification)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve in-memory HMAC audit entries (requires AUDIT_ADMIN_KEY)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Invalid audit access key"
          },
          "503": {
            "description": "Audit log access not configured"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Access-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/rcri": {
      "post": {
        "summary": "Calculate six-factor Lee Index",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "high_risk_surgery": {
                    "type": "boolean"
                  },
                  "ischemic_heart_disease": {
                    "type": "boolean"
                  },
                  "heart_failure": {
                    "type": "boolean"
                  },
                  "cerebrovascular_disease": {
                    "type": "boolean"
                  },
                  "insulin_treatment": {
                    "type": "boolean"
                  },
                  "creatinine_ge_2": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "high_risk_surgery",
                  "ischemic_heart_disease",
                  "heart_failure",
                  "cerebrovascular_disease",
                  "insulin_treatment",
                  "creatinine_ge_2"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RCRI score, class, grouping and historical validation-cohort rate"
          },
          "422": {
            "description": "Missing or invalid risk criteria"
          }
        }
      }
    }
  }
}
